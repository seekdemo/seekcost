# 数据库配置
DATABASE_URL=postgresql+asyncpg://username@localhost:5432/seekcost

# 应用配置
APP_ENV=development
SECRET_KEY=replace-with-a-random-string-at-least-32-characters
SQL_ECHO=false
ALLOW_REGISTRATION=true
# Optional local SQLite-only encrypted snapshots. Empty disables; PostgreSQL uses Restic.
SQLITE_BACKUP_DIR=
SQLITE_BACKUP_INTERVAL_SECONDS=3600
