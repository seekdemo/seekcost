# Replace __DOMAIN__ with your DNS hostname. Install alongside nginx-ip.conf.example.
# The IP site remains the default; this site is selected by TLS SNI.
server {
    listen 127.0.0.1:8444 ssl;
    server_name __DOMAIN__;

    ssl_certificate /etc/ssl/seekcost-domain/fullchain.pem;
    ssl_certificate_key /etc/ssl/seekcost-domain/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 20m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }
}
