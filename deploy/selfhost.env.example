# Generated with python3 scripts/selfhost-init.py; never commit real values.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
SECRET_KEY=
ALLOW_REGISTRATION=false
CORS_ORIGINS=["http://localhost:3000"]
HTTP_PORT=3000
# Persistent paths; keep this folder when upgrading. Do not use /tmp.
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
# Optional pre-initialized Restic S3 repository; same backup password file.
OFFSITE_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Optional HTTPS endpoint accepting {"service":"seekcost-backup","status":"ok|failed"}.
BACKUP_WEBHOOK_URL=
